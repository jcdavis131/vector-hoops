    "definition_plain_english": {
      "draft_pick_quality": "Draft pick quality = first-5-year quality-adjusted minutes surplus vs expected pick value. Actual first5 qual_adj minus expected qual_adj for that overall pick, where expected from historical curve trimmed mean per pick.",
      "cap_efficiency": "Cap efficiency = wins per $M payroll vs league median weighted by Vegas over/under beat. Wins surplus vs median payroll adjusted for preseason Vegas expectation (beat).",
      "foresight_surplus": "Foresight surplus = retained bargain deals where actual salary < expected value and salary growth < cap growth. Sum of (expected_salary - actual) where deal retained and salary growth rate < cap growth rate, indicating foresight to lock value.",
      "timing": "Timing = when you sign/trade/draft matters as contracts mature vs cap $90M->$154M 2015-2025."
    },
    "operationalization": {
      "draft_surplus_formula": "surplus = actual_first5_qual_adj - expected_pick_curve[overall]; qual_adj = mins * q where q=1+0.12*PM+0.05*PTS clamped 0.65-1.65 to mitigate tanking inflated mins",
      "cap_efficiency_formula": "wins_surplus = actual_wins - vegas_over_under; cap_efficiency = wins_surplus / (payroll/$1M) vs league median weighted",
      "foresight_formula": "foresight_surplus = sum_retained (expected_market_salary - actual_salary) where salary_growth < cap_growth and retained_on_rookie_scale or extension bargain",

posecode exercise "Defensive Shuffle — Rim Protector"
  rig humanoid
  pose start = standing

  step "Wide Ready" 0.45s ease-out:
    knees: flex 56
    hips: flex 36
    hips: abduct 32
    ankles: dorsiflex 14
    shoulders: abduct 72
    elbows: flex 58
    wrists: extend 12
    ground-lock: feet
    cue "Hands wide, butt down, eyes up"

  step "Slide Right" 0.38s drive:
    hips: abduct 38
    knees: flex 62
    pelvis: rotate-out 8
    shoulders: abduct 84
    elbows: flex 68
    travel: 0.44 0
    ground-lock: feet
    turn: 8
    cue "Push off left, slide right"

  step "Slide Left" 0.42s settle:
    hips: abduct 36
    pelvis: rotate-out -8
    shoulders: abduct 76
    travel: -0.46 0
    ground-lock: feet
    turn: -8
    cue "Recover left, stay low"

  repeat 2

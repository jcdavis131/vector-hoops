{
  "cleanUrls": false,
  "framework": null,
  "functions": {
    "api/nba/*.js": {
      "regions": ["iad1"],
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://site.api.espn.com; frame-ancestors 'self'"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:path*.mp4"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:path*.jpg"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:path*.png"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:path*.gif"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:path*.webp"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:path*.woff2"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:path*.f32"
    },
    {
      "source": "/assets/:path*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*.onnx",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*.bin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/play"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/play/era-crossed"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/schedule"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/players"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/insights"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/insights/:slug"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/taxonomy"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/methods"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/playoff-runs"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/map-guess"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/twin-network"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/models/mtnn-v5"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/twenty-questions"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/status"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/feed-health"
    }
  ],
  "rewrites": [
    {
      "destination": "https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard",
      "source": "/api/espn/scoreboard"
    },
    {
      "destination": "/live.html",
      "source": "/live"
    },
    {
      "destination": "/replay.html",
      "source": "/replay"
    },
    {
      "destination": "/play.html",
      "source": "/play"
    },
    {
      "destination": "/play/era-crossed.html",
      "source": "/play/era-crossed"
    },
    {
      "destination": "/schedule.html",
      "source": "/schedule"
    },
    {
      "destination": "/players.html",
      "source": "/players"
    },
    {
      "destination": "/methods.html",
      "source": "/methods"
    },
    {
      "destination": "/insights.html",
      "source": "/insights"
    },
    {
      "destination": "/insights/:slug.html",
      "source": "/insights/:slug"
    },
    {
      "destination": "/offline.html",
      "source": "/offline"
    },
    {
      "destination": "/taxonomy.html",
      "source": "/taxonomy"
    },
    {
      "source": "/playoff-runs",
      "destination": "/playoff-runs.html"
    },
    {
      "source": "/map-guess",
      "destination": "/map-guess.html"
    },
    {
      "source": "/twin-network",
      "destination": "/twin-network.html"
    },
    {
      "source": "/models/mtnn-v5",
      "destination": "/models/mtnn-v5.html"
    },
    {
      "source": "/twenty-questions",
      "destination": "/twenty-questions.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/feed-health",
      "destination": "/feed-health.html"
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/insights/era-uniqueness",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/atlas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/daily",
      "destination": "/play",
      "permanent": true
    },
    {
      "source": "/research",
      "destination": "/methods#frontier",
      "permanent": true
    },
    {
      "source": "/leaderboard",
      "destination": "/play",
      "permanent": true
    },
    {
      "source": "/dfs",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/oracle",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/models",
      "destination": "/methods",
      "permanent": true
    },
    {
      "source": "/everyday",
      "destination": "/play",
      "permanent": true
    },
    {
      "source": "/teams",
      "destination": "/#atlas",
      "permanent": true
    },
    {
      "source": "/teams.html",
      "destination": "/#atlas",
      "permanent": true
    },
    {
      "source": "/teams/:slug*",
      "destination": "/#atlas",
      "permanent": true
    },
    {
      "source": "/trends",
      "destination": "/methods#drift",
      "permanent": true
    },
    {
      "source": "/model",
      "destination": "/methods",
      "permanent": true
    },
    {
      "source": "/lab",
      "destination": "/methods",
      "permanent": true
    }
  ]
}

{
  "cleanUrls": false,
  "framework": null,
  "buildCommand": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ],
  "rewrites": [
    {"source": "/play", "destination": "/play.html"},
    {"source": "/players", "destination": "/players.html"},
    {"source": "/model", "destination": "/model.html"},
    {"source": "/trends", "destination": "/trends.html"},
    {"source": "/lab", "destination": "/model.html"},
    {"source": "/methods", "destination": "/methods.html"},
    {"source": "/dfs", "destination": "/index.html"}
  ]
}

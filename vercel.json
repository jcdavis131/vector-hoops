        }
      ],
      "source": "/insights"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/insights/:slug"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/model"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/trends"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/taxonomy"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/methods"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/props-lab"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/playoff-runs"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ],
      "source": "/everyday"
    }
  ],
  "rewrites": [
    {
      "destination": "/live.html",
      "source": "/live"
    },
    {
      "destination": "/play.html",
      "source": "/play"
    },
    {
      "destination": "/players.html",
      "source": "/players"
    },
    {
      "destination": "/model.html",
      "source": "/model"
    },
    {
      "destination": "/trends.html",
      "source": "/trends"
    },
    {
      "destination": "/model.html",
      "source": "/lab"
    },
    {
      "destination": "/methods.html",
      "source": "/methods"
    },
    {
      "destination": "/teams.html",
      "source": "/teams"
    },
    {
      "destination": "/insights.html",
      "source": "/insights"
    },
    {
      "destination": "/insights/:slug.html",
      "source": "/insights/:slug"
    },
    {
      "destination": "/props-lab.html",
      "source": "/props-lab"
    },
    {
      "destination": "/everyday.html",
      "source": "/everyday"
    },
    {
      "destination": "/offline.html",
      "source": "/offline"
    },
    {
      "destination": "/taxonomy.html",
      "source": "/taxonomy"
    },
    {
      "source": "/playoff-runs",
      "destination": "/playoff-runs.html"
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/research",
      "destination": "/model#frontier",
      "permanent": true
    },
    {
      "source": "/leaderboard",
      "destination": "/play",
      "permanent": true
    },
    {
      "source": "/dfs",
      "destination": "/props-lab",
      "permanent": true
    },
    {
      "source": "/oracle",
      "destination": "/props-lab",
      "permanent": true
    },
    {
      "source": "/models",
      "destination": "/model",
      "permanent": true
    }
  ]
}

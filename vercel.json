{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/games",
      "destination": "/arcade/index.html"
    },
    {
      "source": "/arcade",
      "destination": "/arcade/index.html"
    },
    {
      "source": "/model",
      "destination": "/model.html"
    },
    {
      "source": "/trends",
      "destination": "/trends.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hoops.jcamd.com"
        }
      ],
      "destination": "https://hoops.dumbmodel.com/:path*",
      "permanent": true
    },
    {
      "source": "/wiki",
      "destination": "/players",
      "permanent": true
    },
    {
      "source": "/skills",
      "destination": "/players#profile",
      "permanent": true
    },
    {
      "source": "/drift",
      "destination": "/trends",
      "permanent": true
    }
  ]
}
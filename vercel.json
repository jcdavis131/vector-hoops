{
  "cleanUrls": true,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    }
  ],
  "rewrites": [
    {"source": "/play", "destination": "/play.html"},
    {"source": "/players", "destination": "/players.html"},
    {"source": "/model", "destination": "/model.html"},
    {"source": "/trends", "destination": "/trends.html"},
    {"source": "/lab", "destination": "/model.html"},
    {"source": "/methods", "destination": "/methods.html"},
    {"source": "/dfs", "destination": "/index.html"}
  ]
}

posecode exercise "Jump Shot — Hoops Shooter"
  rig humanoid
  pose start = standing

  step "Gather Low" 0.45s ease-in:
    knees: flex 42
    hips: flex 28
    ankles: dorsiflex 12
    shoulders: flex 38
    elbows: flex 92
    wrists: extend 18
    ground-lock: feet
    cue "Load into legs, ball at waist"

  step "Lift Coiled" 0.35s ease-out:
    knees: flex 84
    hips: flex 68
    ankles: dorsiflex 18
    shoulders: flex 88
    elbows: flex 108
    wrists: extend 22
    ground-lock: feet
    cue "Ball lifts to shooting pocket"

  step "Explode Up" 0.32s drive:
    knees: flex 12
    hips: flex 8
    ankles: plantarflex 26
    shoulders: flex 158
    elbows: flex 28
    wrists: extend 26
    ground-lock: feet
    travel: 0 0.12
    cue "Elevate, extend toward rim"

  step "Release & Follow" 0.28s settle:
    shoulders: flex 164
    elbows: flex 12
    wrists: flex 34
    fingers: flex 52
    knees: flex 18
    ground-lock: feet
    cue "Soft wrist snap, hold follow-through"

  step "Land Soft" 0.5s ease-in-out:
    knees: flex 24
    hips: flex 16
    ankles: dorsiflex 6
    shoulders: flex 22
    elbows: flex 24
    ground-lock: feet
    cue "Absorb landing, reset"

  repeat 1

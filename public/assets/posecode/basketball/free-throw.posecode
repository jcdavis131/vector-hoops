posecode exercise "Free Throw Ritual — Shooter"
  rig humanoid
  pose start = standing
  step "Routine Bounce" 0.6s ease-in-out:
    knees: flex 18
    wrists: flex 12
    elbows: flex 36
    ground-lock: feet
    cue "Two dribbles, breathe"
  step "Set" 0.5s settle:
    knees: flex 28
    hips: flex 18
    shoulders: flex 42
    elbows: flex 96
    wrists: extend 22
    ankles: dorsiflex 8
    ground-lock: feet
    cue "Seat low, pocket high, eyes rim"
  step "Release Free" 0.32s drive:
    knees: flex 8
    hips: flex 6
    ankles: plantarflex 14
    shoulders: flex 156
    elbows: flex 12
    wrists: flex 28
    ground-lock: feet
    cue "Legs lift, soft release"
  step "Hold Follow" 0.9s settle:
    shoulders: flex 152
    elbows: flex 16
    wrists: flex 34
    knees: flex 16
    ground-lock: feet
  repeat 1

posecode exercise "Celebration Arms Up — Crowd"
  rig humanoid
  pose start = standing

  step "Crouch Pump" 0.35s ease-in:
    knees: flex 52
    hips: flex 34
    elbows: flex 102
    shoulders: flex 28
    ground-lock: feet
    cue "Load the pop"

  step "Arms Sky" 0.48s drive:
    knees: flex 12
    hips: flex 6
    ankles: plantarflex 22
    shoulders: abduct 168
    shoulders: flex 14
    elbows: flex 8
    wrists: extend 18
    ground-lock: feet
    travel: 0 0.08
    cue "Hands to sky, big energy"

  step "Flex Hold" 0.6s settle:
    shoulders: flex 34
    elbows: flex 48
    knees: flex 22
    ground-lock: feet
    cue "Hold, soak crowd"

  repeat 1

posecode exercise "Chest Pass — Floor General"
  rig humanoid
  pose start = standing
  step "Ball Chest" 0.28s ease-out:
    shoulders: flex 18
    elbows: flex 84
    wrists: extend 16
    knees: flex 22
    ground-lock: feet
    cue "Thumbs down behind ball"
  step "Punch Through" 0.18s drive:
    shoulders: flex 88
    elbows: flex 8
    wrists: flex 24
    knees: flex 14
    hips: flex 8
    travel: 0 0.14
    ground-lock: feet
    cue "Snap, step through"
  step "Reset" 0.42s settle:
    shoulders: flex 0
    elbows: flex 24
    knees: flex 18
    ground-lock: feet
  repeat 1

posecode exercise "Box Out — Big Anchor"
  rig humanoid
  pose start = standing
  step "Contact" 0.35s ease-in:
    knees: flex 46
    hips: flex 52
    hips: abduct 28
    pelvis: hinge 28
    shoulders: flex -12
    elbows: flex 118
    ground-lock: feet
    cue "Hinge, butt to man, wide base"
  step "Seal & Spread" 0.42s drive:
    knees: flex 58
    hips: abduct 38
    shoulders: abduct 68
    elbows: flex 72
    wrists: extend 14
    pelvis: hinge 36
    travel: -0.16 0
    ground-lock: feet
    cue "Arms wide, drive him back"
  step "Turn to Rebound" 0.38s ease-out:
    pelvis: hinge 12
    hips: abduct 18
    shoulders: flex 88
    elbows: flex 42
    knees: flex 32
    turn: 88
    ground-lock: feet
    cue "Open, chin ball"
  repeat 1
